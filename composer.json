{
	"name": "wordpress/ai",
	"description": "AI features, experiments and capabilities for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/chubes4/php-ai-client.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/chubes4/ai-provider-for-openai.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/WordPress/ai-provider-for-google.git"
		},
		{
			"type": "vcs",
			"url": "https://github.com/Fueled/ai-provider-for-ollama.git"
		}
	],
	"require": {
		"ext-json": "*",
		"php": ">=7.4",
		"wordpress/php-ai-client": "dev-issue/242-embedding-generation",
		"wordpress/ai-provider-for-openai": "dev-feature/issue-32-openai-embeddings",
		"wordpress/ai-provider-for-google": "dev-feature/embeddings",
		"fueled/ai-provider-for-ollama": "dev-feature/embeddings"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpcompatibility/phpcompatibility-wp": "^3.0.0-alpha",
		"phpstan/extension-installer": "^1.3",
		"phpstan/php-8-stubs": "^0.4.36",
		"phpstan/phpstan-deprecation-rules": "^2.0.4",
		"phpstan/phpstan-phpunit": "^2.0.17",
		"phpstan/phpstan": "^2.2.2",
		"phpunit/phpunit": "^8.5|^9.6",
		"slevomat/coding-standard": "^8.0",
		"szepeviktor/phpstan-wordpress": "^2.0.2",
		"wp-coding-standards/wpcs": "^3.2.0",
		"wp-phpunit/wp-phpunit": "^7.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"WordPress\\AI\\": "includes/"
		},
		"files": [
			"includes/helpers.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"WordPress\\AI\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"strauss": {
			"target_directory": "third-party",
			"namespace_prefix": "WordPress\\AiClientDependencies\\",
			"classmap_prefix": "WPAI_EmbeddingPoc_",
			"packages": [
				"nyholm/psr7",
				"php-http/discovery",
				"php-http/httplug",
				"php-http/promise",
				"psr/event-dispatcher",
				"psr/http-client",
				"psr/http-factory",
				"psr/http-message",
				"psr/simple-cache"
			],
			"update_call_sites": [
				"vendor/wordpress/php-ai-client",
				"vendor/wordpress/ai-provider-for-openai",
				"vendor/wordpress/ai-provider-for-google",
				"vendor/fueled/ai-provider-for-ollama"
			]
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "7.4"
		}
	},
	"scripts": {
		"format": "phpcbf --standard=phpcs.xml.dist",
		"lint": "phpcs --standard=phpcs.xml.dist",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "phpunit --strict-coverage",
		"prefix-namespaces": [
			"sh -c 'test -f ./bin/strauss.phar || curl -o bin/strauss.phar -L -C - https://github.com/BrianHenryIE/strauss/releases/download/0.28.0/strauss.phar'",
			"@php bin/strauss.phar"
		],
		"post-install-cmd": [
			"@prefix-namespaces"
		],
		"post-update-cmd": [
			"@prefix-namespaces"
		]
	},
	"scripts-descriptions": {
		"format": "Automatically fix coding standards issues",
		"lint": "Check coding standards compliance",
		"phpstan": "Run static analysis with PHPStan",
		"test": "Run PHPUnit tests",
		"prefix-namespaces": "Embedding PoC only: download (if needed) and run the pinned Strauss phar to prefix the dev-branch embedding dependencies' PSR/HTTP types to match WP core's bundled convention"
	}
}
