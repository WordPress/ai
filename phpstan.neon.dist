parameters:
		# Rules
		treatPhpDocTypesAsCertain: false
		inferPrivatePropertyTypeFromConstructor: true
		checkExplicitMixedMissingReturn: true
		checkFunctionNameCase: true
		checkInternalClassCaseSensitivity: true
		checkTooWideReturnTypesInProtectedAndPublicMethods: true
		polluteScopeWithAlwaysIterableForeach: false
		polluteScopeWithLoopInitialAssignments: false
		reportAlwaysTrueInLastCondition: true
		reportStaticMethodSignatures: true
		reportWrongPhpDocTypeInVarTag: true

		# Configuration
		level: 8
		phpVersion:
			min: 70400
			max: 80400
		bootstrapFiles:
				- ai.php
		paths:
				- ai.php
				- uninstall.php
				- includes/
		scanFiles:
			- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
			# These are needed due config.platform.php being 7.4 in composer.json and wordpress-stubs not including polyfills.
			# See <https://github.com/php-stubs/wordpress-stubs/issues/100>.
			- vendor/phpstan/php-8-stubs/stubs/ext/standard/str_contains.php
			- vendor/phpstan/php-8-stubs/stubs/ext/standard/str_starts_with.php
		# Temporary while WP 7.0 beta AI Client migration is in progress.
		ignoreErrors:
			- '#Function wp_ai_client_prompt not found\.#'
			- '#WP_AI_Client_[A-Za-z0-9_]+#'
			- '#WordPress\\AiClient\\#'
			- '#Function wp_get_connectors not found\.#'
			- '#Function wp_is_connector_registered not found\.#'
			- '#Function wp_get_connector not found\.#'
			-
				identifier: class.notFound
				message: '#WP_Connector_Registry#'
			- '#class cli\\progress\\Bar#'
			- '#Function wp_supports_ai not found\.#'
			- '#Function wp_set_script_module_translations not found\.#'
			# Entity Fields API and view configuration, WordPress 7.2.
			- '#Function wp_update_entity_fields not found\.#'
			- '#Function wp_get_registered_entity_fields not found\.#'
			- '#Function wp_get_entity_view_config_hook_name not found\.#'
			-
				identifier: class.notFound
				message: '#WP_View_Config_Data#'
		excludePaths:
			analyse:
				- tests/
				- vendor/
				# Vendored third-party SDK. Scanned for symbol resolution
				# but exempt from our coding-standard/analysis rules.
				- includes/Vendor/
				- includes/Logging/Logging_Integration.php
				- includes/Logging/Logging_Http_Transporter.php
			analyseAndScan:
				- node_modules (?)
				- includes/Vendor/AiClient/src/
				- includes/Vendor/Secrets/src/
